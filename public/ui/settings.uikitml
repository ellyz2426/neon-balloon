<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 28;
    gap: 14;
    background-color: rgba(0, 4, 16, 0.95);
    border-radius: 14;
    border-color: rgba(224, 64, 251, 0.5);
    border-width: 2;
    width: 380;
    height: 480;
  }
  .heading {
    font-size: 28;
    color: #e040fb;
  }
  .section-label {
    font-size: 12;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 4;
  }
  .option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 300;
    padding: 6;
  }
  .opt-label {
    font-size: 15;
    color: rgba(255, 255, 255, 0.8);
  }
  .opt-value {
    font-size: 15;
    color: #e040fb;
  }
  .toggle-btn {
    padding: 6;
    background-color: rgba(224, 64, 251, 0.12);
    border-radius: 4;
    border-color: rgba(224, 64, 251, 0.3);
    border-width: 1;
    cursor: pointer;
    width: 36;
    align-items: center;
  }
  .toggle-text {
    font-size: 14;
    color: #ffffff;
  }
  .divider {
    width: 300;
    height: 1;
    background-color: rgba(224, 64, 251, 0.2);
  }
  .btn {
    padding: 12;
    background-color: rgba(224, 64, 251, 0.15);
    border-radius: 8;
    border-color: rgba(224, 64, 251, 0.4);
    border-width: 1;
    width: 200;
    align-items: center;
    cursor: pointer;
    margin-top: 8;
  }
  .btn-text {
    font-size: 16;
    color: #ffffff;
  }
</style>
<Panel class="root">
  <div class="heading">SETTINGS</div>
  <div class="section-label">DIFFICULTY</div>
  <div class="option-row">
    <div class="opt-label">Difficulty</div>
    <div class="opt-value" id="difficulty-val">NORMAL</div>
  </div>
  <div class="option-row">
    <div class="toggle-btn" id="btn-diff-down"><div class="toggle-text">◀</div></div>
    <div class="toggle-btn" id="btn-diff-up"><div class="toggle-text">▶</div></div>
  </div>
  <div class="divider"></div>
  <div class="section-label">AUDIO</div>
  <div class="option-row">
    <div class="opt-label">Music</div>
    <div class="opt-value" id="music-val">50%</div>
  </div>
  <div class="option-row">
    <div class="toggle-btn" id="btn-music-down"><div class="toggle-text">−</div></div>
    <div class="toggle-btn" id="btn-music-up"><div class="toggle-text">+</div></div>
  </div>
  <div class="option-row">
    <div class="opt-label">SFX</div>
    <div class="opt-value" id="sfx-val">70%</div>
  </div>
  <div class="option-row">
    <div class="toggle-btn" id="btn-sfx-down"><div class="toggle-text">−</div></div>
    <div class="toggle-btn" id="btn-sfx-up"><div class="toggle-text">+</div></div>
  </div>
  <div class="divider"></div>
  <div class="section-label">COLOR THEME</div>
  <div class="option-row">
    <div class="opt-label">Theme</div>
    <div class="opt-value" id="theme-val">CYAN</div>
  </div>
  <div class="option-row">
    <div class="toggle-btn" id="btn-theme-down"><div class="toggle-text">◀</div></div>
    <div class="toggle-btn" id="btn-theme-up"><div class="toggle-text">▶</div></div>
  </div>
  <div class="divider"></div>
  <div class="btn" id="btn-settings-back">
    <div class="btn-text">BACK</div>
  </div>
</Panel>
