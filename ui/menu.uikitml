<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 32;
    gap: 16;
    background-color: rgba(0, 4, 16, 0.95);
    border-radius: 16;
    border-color: rgba(0, 200, 255, 0.6);
    border-width: 2;
    width: 420;
    height: 520;
  }
  .title {
    font-size: 36;
    color: #00e5ff;
    margin-bottom: 4;
  }
  .subtitle {
    font-size: 14;
    color: rgba(0, 229, 255, 0.6);
    margin-bottom: 16;
  }
  .modes-label {
    font-size: 13;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 4;
  }
  .btn {
    padding: 14;
    background-color: rgba(0, 200, 255, 0.12);
    border-radius: 8;
    border-color: rgba(0, 200, 255, 0.35);
    border-width: 1;
    width: 320;
    align-items: center;
    cursor: pointer;
  }
  .btn-accent {
    padding: 14;
    background-color: rgba(255, 0, 128, 0.15);
    border-radius: 8;
    border-color: rgba(255, 0, 128, 0.5);
    border-width: 1;
    width: 320;
    align-items: center;
    cursor: pointer;
  }
  .btn-text {
    font-size: 18;
    color: #ffffff;
  }
  .btn-desc {
    font-size: 11;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 2;
  }
  .bottom-row {
    flex-direction: row;
    gap: 12;
    margin-top: 12;
  }
  .small-btn {
    padding: 10;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6;
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 1;
    width: 150;
    align-items: center;
    cursor: pointer;
  }
  .small-text {
    font-size: 14;
    color: rgba(255, 255, 255, 0.7);
  }
</style>
<Panel class="root">
  <div class="title" id="title">NEON BALLOON</div>
  <div class="subtitle">FLOATING COMBAT ARCADE</div>
  <div class="modes-label">SELECT MODE</div>
  <div class="btn-accent" id="btn-arcade">
    <div class="btn-text">ARCADE MODE</div>
    <div class="btn-desc">Phase-based waves — defeat all enemies</div>
  </div>
  <div class="btn" id="btn-trip">
    <div class="btn-text">BALLOON TRIP</div>
    <div class="btn-desc">Side-scrolling obstacle course</div>
  </div>
  <div class="btn" id="btn-survival">
    <div class="btn-text">SURVIVAL</div>
    <div class="btn-desc">Endless waves — how long can you last?</div>
  </div>
  <div class="bottom-row">
    <div class="small-btn" id="btn-settings">
      <div class="small-text">SETTINGS</div>
    </div>
    <div class="small-btn" id="btn-stats">
      <div class="small-text">STATS</div>
    </div>
  </div>
  <div class="small-btn" id="btn-tutorial">
    <div class="small-text">HOW TO PLAY</div>
  </div>
</Panel>
